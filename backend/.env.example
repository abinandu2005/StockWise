# StockWise Backend — Environment Variables
# Copy this to .env and fill in your actual values

# ── JWT ───────────────────────────────────────────────────
JWT_SECRET=ThisIsAVeryStrongSecretKeyForStockWiseJWTAuthentication2024!@#

# ── MySQL (Auth Service) ──────────────────────────────────
MYSQL_ROOT_PASSWORD=stockwise_root
MYSQL_USERNAME=root

# ── MongoDB ───────────────────────────────────────────────
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://<user>:<pass>@cluster.mongodb.net
MONGO_URI=mongodb://localhost:27017/stockwise_inventory
MONGO_USERNAME=admin
MONGO_PASSWORD=stockwise_mongo

# ── Email (SMTP) ──────────────────────────────────────────
MAIL_HOST=smtp.gmail.com
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-app-password


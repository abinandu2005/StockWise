# Copy this file to .env and fill in your values.
# All variables must be prefixed with VITE_ to be accessible in the browser.
#
# Architecture: React (:5173) → API Gateway (:9090) → Microservices
#
# Service ports (for reference):
#   API Gateway           :9090  ← all frontend traffic goes here
#   Auth Service          :8081
#   Inventory Service     :8082
#   Supplier/Customer     :8083
#   Purchase Order        :8084
#   Sales & Dispatch      :8085
#   Analytics & Reports   :8086

# Point to your Spring Boot API Gateway
VITE_API_URL=http://localhost:9090/api

# Application display name
VITE_APP_NAME=StockWise
